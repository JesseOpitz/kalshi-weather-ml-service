APP_NAME=Kalshi Weather ML Service
APP_ENV=development
LOG_LEVEL=INFO
API_PREFIX=/v1

# Generate each with: python scripts/generate_api_key.py
ML_SERVICE_API_KEYS=replace-with-a-long-random-key
ADMIN_API_KEY=replace-with-a-separate-long-random-admin-key

DATABASE_URL=sqlite:///./data/weather_ml.sqlite3
REDIS_URL=redis://redis:6379/0
TASK_ALWAYS_EAGER=true

MODEL_STORE_URI=./artifacts
ACTIVE_MODEL_CACHE_SECONDS=60
MIN_DATA_QUALITY_SCORE=0.70
MAX_INPUT_DATA_AGE_SECONDS=7200
MIN_TRAINING_ROWS=250

RATE_LIMIT_REQUESTS=240
RATE_LIMIT_WINDOW_SECONDS=60
CORS_ORIGINS=[]
TRUSTED_HOSTS=["*"]

OPEN_METEO_ARCHIVE_URL=https://archive-api.open-meteo.com/v1/archive
OPEN_METEO_HISTORICAL_FORECAST_URL=https://historical-forecast-api.open-meteo.com/v1/forecast
NWS_API_URL=https://api.weather.gov
HTTP_USER_AGENT=kalshi-weather-ml-service/1.0 contact@example.com
HTTP_TIMEOUT_SECONDS=45

S3_ENDPOINT_URL=
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

PROMETHEUS_ENABLED=true
AUTO_CREATE_TABLES=true
