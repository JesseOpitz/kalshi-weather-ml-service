from __future__ import annotations

import argparse
import json
import secrets
from pathlib import Path

from app.db.base import Base
from app.db.models import Station
from app.db.session import SessionLocal, engine
from app.services.model_service import model_health


def init_db() -> None:
    Base.metadata.create_all(bind=engine)
    print("Database initialized.")


def seed_stations(path: str) -> None:
    records = json.loads(Path(path).read_text())
    with SessionLocal() as db:
        for payload in records:
            station = (
                db.query(Station)
                .filter(Station.station_code == payload["station_code"])
                .one_or_none()
            )
            if station is None:
                station = Station(
                    station_code=payload["station_code"],
                    station_name=payload["station_name"],
                    latitude=payload["latitude"],
                    longitude=payload["longitude"],
                )
                db.add(station)
            station.station_name = payload["station_name"]
            station.latitude = payload["latitude"]
            station.longitude = payload["longitude"]
            station.elevation_m = payload.get("elevation_m")
            station.timezone = payload.get("timezone", "UTC")
            station.official_source = payload.get("official_source")
            station.metadata_json = payload.get("metadata", {})
        db.commit()
    print(f"Seeded {len(records)} stations.")


def print_health() -> None:
    with SessionLocal() as db:
        payload = model_health(db)
    print(json.dumps(payload, indent=2, default=str))


def main() -> None:
    parser = argparse.ArgumentParser(prog="weather-ml")
    subparsers = parser.add_subparsers(dest="command", required=True)
    subparsers.add_parser("init-db")
    seed = subparsers.add_parser("seed-stations")
    seed.add_argument("path", nargs="?", default="config/stations.example.json")
    subparsers.add_parser("model-health")
    subparsers.add_parser("generate-key")
    args = parser.parse_args()
    if args.command == "init-db":
        init_db()
    elif args.command == "seed-stations":
        seed_stations(args.path)
    elif args.command == "model-health":
        print_health()
    elif args.command == "generate-key":
        print(secrets.token_urlsafe(48))


if __name__ == "__main__":
    main()
